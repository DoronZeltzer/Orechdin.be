# Orechdin website — environment variables
# Copy this file to `.env.local` for local development, or configure the
# same keys in your hosting provider (Vercel / Cloudflare) for production.
#
# IMPORTANT: do NOT commit `.env.local` — it is gitignored on purpose.

# --- Site -----------------------------------------------------------------
# Public canonical URL of the site. Used for sitemap, robots, JSON-LD,
# canonical links, and Open Graph URLs. Override per environment.
NEXT_PUBLIC_SITE_URL="https://www.orechdin.be"

# --- Persistence (Supabase / Postgres) -----------------------------------
# The app talks to Postgres via drizzle (postgres-js driver). In production
# use the Supabase connection string.
#   • App runtime (Vercel serverless)  -> Transaction pooler URL, port 6543
#     e.g. postgresql://postgres.<ref>:[PASSWORD]@<region>.pooler.supabase.com:6543/postgres
#   • Running migrations (db:migrate)  -> Direct connection, port 5432
# Leave unset for local dev to fall back to a lazy localhost client (the
# marketing site builds and runs without a database).
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Auth (better-auth) ---------------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- NEO assistant — intake / OTP gating ---------------------------------
# Controls whether the chat collects a verifiable email + ships the brief.
#   "off"  — chat only, no intake UI, no submissions (production-safe default).
#   "demo" — interactive demo. Accepts any 4-char OTP. The brief is built
#            into a real PDF + DOCX server-side, but `sendBrief()` only
#            console-warns instead of dispatching — see lib/neo/send-brief.ts.
#   "live" — real outbound delivery. The IMAP / Microsoft Graph adapter is
#            stubbed with `IntakeChannelNotConfiguredError`; wire it in
#            lib/neo/send-brief.ts when the office's mail channel is ready.
NEXT_PUBLIC_NEO_INTAKE_MODE="off"

# --- M05 FREE AI (no-developer-key plane) -------------------------------
# FREEAI_NOKEY_ADMIN_TOKEN=""          # Bearer token for /admin/status in production
# FREEAI_NOKEY_AIHORDE_ENABLED="false"
# FREEAI_NOKEY_GRADIO_ENABLED="false"
# FREEAI_NOKEY_CACHE_DISABLED="false"
# OLLAMA_HOST="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.2"

# --- Brief delivery channel (wired later) --------------------------------
# No external transactional-email key is required. The brief generator
# (PDF + DOCX) runs entirely server-side from the visitor's own messages
# and never calls a paid AI provider. Outbound delivery is intentionally
# left as a stub — fill these in when you connect the firm's IMAP /
# Microsoft 365 account:
#
#   ORECHDIN_OUTBOX_HOST=""        # e.g. smtp.office365.com
#   ORECHDIN_OUTBOX_PORT="587"
#   ORECHDIN_OUTBOX_USER=""        # the firm's intake mailbox
#   ORECHDIN_OUTBOX_PASSWORD=""    # or app password / OAuth token
#   ORECHDIN_OUTBOX_FROM=""        # display address on the brief email
