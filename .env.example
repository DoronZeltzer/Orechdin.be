# Orechdin website — environment variables
# Copy this file to `.env.local` for local development, or configure the
# same keys in your hosting provider (Vercel / Cloudflare) for production.
#
# IMPORTANT: do NOT commit `.env.local` — it is gitignored on purpose.

# --- Site -----------------------------------------------------------------
# Public canonical URL of the site. Used for sitemap, robots, JSON-LD,
# canonical links, and Open Graph URLs. Override per environment.
NEXT_PUBLIC_SITE_URL="https://www.orechdin.be"

# --- Contact form (email delivery) ---------------------------------------
# The contact form posts to /api/contact, which emails the office through the
# SMTP account below. Nothing is stored and no third party is involved.
# If these are not set, the route answers "not configured" and the form shows
# the visitor the office's phone number and email address instead, so a missing
# setting can never swallow a message silently.
#   - Office 365:  smtp.office365.com : 587  (needs SMTP AUTH enabled + an
#                  app password if MFA is on)
#   - Google Workspace: smtp.gmail.com : 587  (use an App Password)
#   - Most hosts:  their SMTP host : 587 (STARTTLS) or 465 (implicit TLS)
#
#   ORECHDIN_OUTBOX_HOST=""        # e.g. smtp.office365.com
#   ORECHDIN_OUTBOX_PORT="587"     # 587 = STARTTLS, 465 = implicit TLS
#   ORECHDIN_OUTBOX_USER=""        # mailbox login
#   ORECHDIN_OUTBOX_PASSWORD=""    # mailbox / app password
#   ORECHDIN_OUTBOX_FROM=""        # the From address, e.g. info@orechdin.be
#   ORECHDIN_CONTACT_TO=""         # where enquiries land (defaults to FROM)
