# ORECH/DIN: rules for the website on Apache-style hosting (Easyhost).
# If the server turns out to ignore this file (it uses nginx), give nginx-snippet.conf to Easyhost support.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical address: www.orechdin.be (the bare orechdin.be forwards to it).
    # (The certificate authority's ownership check under /.well-known/acme-challenge/ is answered directly,
    # never redirected, so the free https certificate can be issued for both names.)
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{HTTP_HOST} ^orechdin\.be$ [NC]
    RewriteRule ^ https://www.orechdin.be%{REQUEST_URI} [R=301,L]

    # The bare address goes to the English home page.
    RewriteRule ^$ /en/ [R=301,L]

    # The old Wix addresses keep working, forwarded for good to their new pages.
    RewriteRule ^the-office/?$ /en/office/ [R=301,L]
    RewriteRule ^services/?$ /en/services/ [R=301,L]
    RewriteRule ^contact-8/?$ /en/contact/ [R=301,L]
    RewriteRule ^privacy-policy/?$ /en/privacy/ [R=301,L]
    RewriteRule ^cookies/?$ /en/cookies/ [R=301,L]
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# The same security headers as on Vercel (next.config.ts).
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://www.google.com/maps"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-DNS-Prefetch-Control "on"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Pages are always re-checked; the hashed files under /_next/static never change; photos for a week.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/media/#">
        Header set Cache-Control "public, max-age=604800"
    </If>
</IfModule>
